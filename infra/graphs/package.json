{
  "name": "jarvis-graphs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LangGraph 실행 뼈대 — 그래프 모양인 일만 돌리는 전용 엔진(실행기·안전장치·연기 시험 그래프)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-interrupt-nodes.mjs graphs && node scripts/check-graph-rules.mjs graphs",
    "report": "node lg-report.mjs",
    "selftest": "node run.mjs selftest"
  },
  "dependencies": {
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "better-sqlite3": "12.11.1",
    "zod": "4.6.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}

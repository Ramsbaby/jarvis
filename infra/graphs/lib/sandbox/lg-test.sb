(version 1)
;; lg-test.sb — LLM 이 쓴 시험·분석 코드를 가두는 격리 규칙(설계 §3 · L2 위험 A~D). 1b 전제 조건.
;; 바탕은 '전부 막음'이다. 읽기·쓰기·실행·네트워크 모두 허용 목록으로 연다(금지 목록은 빈틈이 남는다 — L 중4).
;; 이 파일은 틀이다. sandboxed-run.mjs 가 변수(-D)를 실제 경로(realpath)로 채우고, 실행 직전에 열려 있던 로컬 포트를
;; 막는 줄을 끝에 덧붙여 sandbox-exec 에 넘긴다. 사람이 직접 부르지 않는다.
;;
;; 변수
;;   COPY          사본(역사 없는 내보내기 + 새 git init). 읽기·쓰기 — 단 .git 은 쓰기 금지(L2 위험 A: 훅·fsmonitor 심기)
;;   TMP           이 실행 전용 임시 폴더. 읽기·쓰기. HOME·TMPDIR 를 이 아래로 돌린다(flutter 설정·분석 파일이 진짜 홈에 안 닿게)
;;   FLUTTER_ROOT  flutter SDK(공개 소스·바이너리). 읽기만
;;   PUB_CACHE     pub 캐시(공개 패키지 소스). 읽기만
;;
;; 10-03 실측(macOS 26.4.1, flutter 3.38.9, 고스톱 사본): 이 규칙 안에서 flutter test 가 오프라인으로 초록.
;; 막혀도 시험이 통과하는 것(그래서 열지 않는다): CFPreferences 전역 읽기, ~/Library/Caches 읽기,
;; launchservicesd(앱 실행 경로 — 열면 격리 밖에서 프로그램을 띄울 수 있다), distributed_notifications.

(deny default)

;; 시스템 바탕(동적 라이브러리·프레임워크·/usr/lib·/usr/share·기본 mach 서비스 몇 개).
;; 경로 따라가기용 메타데이터(stat) 읽기는 여기서 전역으로 열린다. 홈 아래만은 sandboxed-run.mjs 가 끝에 다시 막고
;; 허용 경로와 그 조상만 연다(홈 아래 파일은 있는지·크기조차 안 보이게 — 본 저장소 파일 이름 짐작 막기).
(import "bsd.sb")

;; ── 읽기: 허용 목록. $HOME 아래는 사본·임시·pub 캐시만 — 본 저장소·~/keys·~/.ssh·~/.config·~/.openclaw*·~/.claude·
;;    브라우저·셸 기록은 자동으로 막힌다(L2 위험 B). /tmp·/var/folders(다른 작업 폴더·임시 파일)·/opt/homebrew/var·/Volumes 도 막힌다.
(allow file-read*
  (subpath (param "COPY"))
  (subpath (param "TMP"))
  (subpath (param "FLUTTER_ROOT"))
  (subpath (param "PUB_CACHE")))

;; ── 쓰기: 사본(.git 제외)과 임시 폴더만. .GIT·./.git·lib/../.git·/tmp 별칭으로 돌아가도 막힌다(실측).
(allow file-write* (subpath (param "TMP")))
(allow file-write*
  (require-all
    (subpath (param "COPY"))
    (require-not (subpath (string-append (param "COPY") "/.git")))))
;; bsd.sb·system.sb 가 여는 쓰기 두 곳을 다시 막는다. 앞선 허용을 이기려면 같은 세부 동작 이름으로 막아야 한다
;; (file-write* 로 막으면 bsd.sb 의 file-write-data 허용이 그대로 남는다 — 실측).
;;   · 이름이 .CFUserTextEncoding 인 파일이면 어디든 덮어쓰기 · /cores 아래 파일 만들기(코어 덤프 자리 — 디스크 채우기)
(deny file-write-data (require-all (regex #"/\.CFUserTextEncoding$") (require-not (subpath (param "TMP")))))
(deny file-write-create (prefix "/cores/"))

;; ── 실행: 허용 목록(L2 위험 D). git·security·curl·셸·인터프리터는 목록에 없으니 막힌다.
;;    flutter 는 셸 스크립트 진입점(git rev-parse 를 부른다)을 거치지 않고 dart + flutter_tools 스냅숏으로 바로 부른다.
;;    which·sysctl: flutter 도구가 시작할 때 부른다(안드로이드 aapt 찾기 · hw.optional.arm64). 둘 다 다른 프로그램을 띄우지 못한다.
;;    impellerc: 새 사본에서 처음 시험할 때 셰이더(ink_sparkle.frag)를 build/unit_test_assets 로 컴파일한다(실측). 읽고 쓰기만 한다.
(allow process-fork)
(allow process-exec
  (literal (string-append (param "FLUTTER_ROOT") "/bin/cache/dart-sdk/bin/dart"))
  (literal (string-append (param "FLUTTER_ROOT") "/bin/cache/dart-sdk/bin/dartvm"))
  (literal (string-append (param "FLUTTER_ROOT") "/bin/cache/dart-sdk/bin/dartaotruntime"))
  (literal (string-append (param "FLUTTER_ROOT") "/bin/cache/artifacts/engine/darwin-x64/flutter_tester"))
  (literal (string-append (param "FLUTTER_ROOT") "/bin/cache/artifacts/engine/darwin-x64/impellerc"))
  (literal "/usr/bin/which")
  (literal "/usr/sbin/sysctl"))
;; flutter 도구가 끝난 시험 프로세스(flutter_tester)를 끈다 — 같은 격리 안끼리만. 격리 밖 프로세스에는 신호를 못 보낸다.
(allow signal (target same-sandbox))

;; ── 네트워크: 루프백만(L2 위험 C). flutter test 는 도구 ↔ flutter_tester 사이에 루프백 소켓이 꼭 필요하다.
;;    'remote ip' 정밀 규칙이어야 한다 — 소박한 network*…localhost 규칙은 공인 IP 까지 샌다(L2 실증).
;;    localhost 는 127.0.0.1 과 ::1 을 함께 뜻한다(실측). LAN·Tailscale 주소, DNS, 유닉스 소켓(ssh-agent·docker)은 막힌다.
;;    한계(실측): bind·inbound 의 주소 자리는 * 나 localhost 만 받고 0.0.0.0 도 localhost 로 친다. 들어오는 연결은 리슨할 때만 보고
;;    연결마다 상대 주소를 보지 않는다 → 0.0.0.0 리슨에 LAN 이 붙을 수 있다. 그래서 sandboxed-run.mjs 가 리슨 소켓을 감시해 끈다.
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))

;; 로컬 서비스 포트는 따로 막는다(뒤에 오는 규칙이 이긴다 — 실측). 게이트웨이 18789 · 크롬 CDP 9222 · adb 5037 · ollama 11434 · 보드 3100.
;; 실행 직전에 열려 있던 다른 루프백 포트도 sandboxed-run.mjs 가 이 뒤에 덧붙여 막는다(Syncthing 8384 등).
(deny network-outbound
  (remote ip "localhost:18789")
  (remote ip "localhost:9222")
  (remote ip "localhost:5037")
  (remote ip "localhost:11434")
  (remote ip "localhost:3100"))
;; 받는 쪽도 같은 포트를 막는다(독립 검토 중1 — 실측 재현): 격리 코드가 그 포트에 대신 리슨하면 밖 프로그램이 격리 코드에 붙는다
;; (게이트웨이·보드는 * 바인드라 127.0.0.1 이, 127.0.0.1 전용인 CDP·adb·ollama 는 ::1 이 더 구체적이라 가로챈다 → 토큰을 넘겨받을 수 있다).
(deny network-bind
  (local ip "localhost:18789")
  (local ip "localhost:9222")
  (local ip "localhost:5037")
  (local ip "localhost:11434")
  (local ip "localhost:3100"))
(deny network-inbound
  (local ip "localhost:18789")
  (local ip "localhost:9222")
  (local ip "localhost:5037")
  (local ip "localhost:11434")
  (local ip "localhost:3100"))

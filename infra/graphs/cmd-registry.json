      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 3600,
      "params": {
        "rev": "^[A-Za-z0-9._/-]{1,60}$"
      },
      "maxSeconds": 5400
    },
    "gostop.qa-emu-up": {
      "desc": "gostop_ads 를 창 없이 띄우고 비행기 모드(외부 송출 0). 남의 에뮬레이터가 있으면 거부",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "emu-up"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 600,
      "maxSeconds": 900
    },
    "gostop.qa-emu-down": {
      "desc": "우리가 띄운 에뮬레이터만 끈다(표식 pid)",
      "bin": "/opt/homebrew/bin/python3",

    },
    "git.wt-head": {
      "desc": "⑯ — 출시 작업 폴더의 커밋 해시(읽기만). push 결과 확인(verify)용으로 남긴다",
      "bin": "/usr/bin/git",
      "argv": [
        "-C",
        "{wt}",
        "rev-parse",
        "HEAD"
      ],
      "params": {
        "wt": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)+gostop/release-wt/[A-Za-z0-9][A-Za-z0-9._-]{0,80}$"
      },
      "modes": [
        "live"
      ],
      "timeoutSec": 30,
      "maxSeconds": 45
    },
    "git.ls-remote-master": {
      "desc": "⑯ verify(실제 전용) — origin master 의 해시(읽기만, 네트워크). 시작만 적히고 끝이 없는 커밋·push 가 실제로 일어났는지 본다",
      "bin": "/usr/bin/git",
      "argv": [
        "-C",
        "{repo}",
        "ls-remote",
        "origin",
        "refs/heads/master"
      ],
      "params": {
        "repo": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)*gostop_app$"
      },
      "modes": [
        "live"
      ],
      "timeoutSec": 60,
      "maxSeconds": 90
    },
    "gateway.listen-pid": {
      "desc": "당직 D0(duty-verify) — 게이트웨이 포트에 LISTEN 하는 pid(읽기 전용). 없으면 코드 1. OpenClaw CLI 는 S15 로 쓰지 않는다",
      "bin": "/usr/sbin/lsof",
      "argv": [
        "-nP",
        "-t",
        "-i",
        "{spec}",
        "-sTCP:LISTEN"
      ],
      "params": {
        "spec": "^TCP:[0-9]{2,5}$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "cwd": "/",
      "timeoutSec": 15
    },
    "gateway.proc": {
      "desc": "당직 D0 — 게이트웨이 프로세스 나이(etime, 시작 시각 = 지금 - 나이). 읽기 전용",
      "bin": "/bin/ps",
      "argv": [
        "-o",
        "pid=,etime=",
        "-p",
        "{pid}"
      ],
      "params": {
        "pid": "^[1-9][0-9]{0,6}$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "cwd": "/",
      "timeoutSec": 10
    },
    "gateway.health": {
      "desc": "당직 D0 — 게이트웨이 HTTP /health(인증 없는 살아 있음 확인, 127.0.0.1 만). 읽기 전용",
      "bin": "/usr/bin/curl",
      "argv": [
        "-s",
        "-m",
        "5",
        "{url}"
      ],
      "params": {
        "url": "^http://127\\.0\\.0\\.1:[0-9]{2,5}/health$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "cwd": "/",
      "timeoutSec": 10
    },
    "graphs.disk-reclaim": {
      "desc": "디스크 관문 자가 회복 — 워크스페이스 scripts/disk-reclaim.sh(당직과 같은 도구, 실행 파일 직접 — 셸 금지 규칙): 다시 만들어지는 것만 치운다(flutter 빌드 산출물·옛 QA APK·uv/npm 캐시·랭그래프 시험 임시). 대화 작업 표식·돌던 flutter 는 건너뜀. 실측 약 4~5GB(10-05)",
      "bin": "~/.openclaw/workspace/scripts/disk-reclaim.sh",
      "argv": [],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 600
    }
  }
}

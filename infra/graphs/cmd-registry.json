      ],
      "timeoutSec": 60,
      "maxSeconds": 90
    },
    "gostop.qa-build": {
      "desc": "QA 드라이버를 얹은 디버그 APK(커밋·드라이버 지문별 캐시). git archive 로 /tmp 에 풀어 빌드 후 지운다",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",

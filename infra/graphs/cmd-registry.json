{
  "version": 1,
  "note": "그래프 노드가 run(cmdId, 인자)·launch(cmdId, 인자)로 실행할 수 있는 명령의 허용 목록(정본). 모드별 허용(modes), 부수효과 명령은 effect:true(실제 모드 전용, effect() 안에서만). 셸·env·OpenClaw CLI·인터프리터 즉석 코드는 올릴 수 없다(lib/run.mjs 가 거부). timeoutSec: 명령 시간 제한. maxSeconds: 분리 실행(launch) 최대 시간 — 시작부터 이만큼 넘기면 확인(check)이 프로세스 묶음째 끄고 dead(timeout)(설계 §6). timeoutSec 보다 커야 하고, 첫 값은 알려진 상한(실측)의 1.5배다 — 동기 명령은 기동 흔들림 때문에 시간 제한 하한 30초. 없으면 LG_DETACH_MAX_SEC(5400). 고스톱 명령(git·tar·flutter·gh)은 1a 에서 더했다 — 전부 읽기 또는 사본 안 명령이고 effect 명령은 아직 없다.",
  "commands": {
    "sys.true": {
      "desc": "입구 자가 시험 — 아무것도 하지 않고 0",
      "bin": "/usr/bin/true",
      "argv": [],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 10,
      "maxSeconds": 15
    },
    "sys.sleep": {
      "desc": "분리 실행·시간 상한 실측용 대기(초)",
      "bin": "/bin/sleep",
      "argv": [
        "{seconds}"
      ],
      "params": {
        "seconds": "^[0-9]{1,4}$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 3600,
      "maxSeconds": 5400
    },
    "git.rev-parse": {
      "desc": "고스톱 본 저장소 읽기 — 커밋 이름을 전체 해시로(없으면 코드 1). 실측 0.1초 미만 — 동기 명령은 기동 흔들림 하한 30초",
      "bin": "/usr/bin/git",
      "argv": [
        "-C",
        "{repo}",
        "rev-parse",
        "--verify",
        "--quiet",
        "{rev}"
      ],
      "params": {
        "repo": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)*gostop_app$",
        "rev": "^(?:[0-9a-f]{7,40}|HEAD)\\^?$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 30,
      "maxSeconds": 45
    },
    "git.last-commit-time": {
      "desc": "고스톱 본 저장소 읽기 — 모든 가지 중 가장 최근 커밋 시각(초). 대화 작업 표식(최근 30분 커밋) 판정용. 실측 0.1초 미만",
      "bin": "/usr/bin/git",
      "argv": [
        "-C",
        "{repo}",
        "log",
        "--all",
        "-1",
        "--format=%ct"
      ],
      "params": {
        "repo": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)*gostop_app$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 30,
      "maxSeconds": 45
    },
    "git.archive": {
      "desc": "고스톱 본 저장소 읽기 — 대상 커밋 한 판만 tar 로 내보낸다(역사 없음). 사본 자리의 src.tar 로만 쓴다. 실측 1초 미만(91MB)",
      "bin": "/usr/bin/git",
      "argv": [
        "-C",
        "{repo}",
        "archive",
        "--format=tar",
        "-o",
        "{out}",
        "{rev}"
      ],
      "params": {
        "repo": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)*gostop_app$",
        "out": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)+gostop/sandbox/[A-Za-z0-9][A-Za-z0-9._-]{0,80}/src\\.tar$",
        "rev": "^(?:[0-9a-f]{7,40}|HEAD)\\^?$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 30,
      "maxSeconds": 45
    },
    "tar.extract-sandbox": {
      "desc": "사본 풀기 — 설정·비밀(.claude·.mcp.json·key.properties·서명 키·google-services.json·GoogleService-Info.plist)은 빼고 푼다(설계 §2). 실측 1초 미만",
      "bin": "/usr/bin/tar",
      "argv": [
        "-xf",
        "{tar}",
        "-C",
        "{dir}",
        "--exclude",
        ".claude",
        "--exclude",
        ".mcp.json",
        "--exclude",
        "android/key.properties",
        "--exclude",
        "*.jks",
        "--exclude",
        "*.keystore",
        "--exclude",
        "android/app/google-services.json",
        "--exclude",
        "ios/Runner/GoogleService-Info.plist"
      ],
      "params": {
        "tar": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)+gostop/sandbox/[A-Za-z0-9][A-Za-z0-9._-]{0,80}/src\\.tar$",
        "dir": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)+gostop/sandbox/[A-Za-z0-9][A-Za-z0-9._-]{0,80}/(?:work|clean)$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 30,
      "maxSeconds": 45
    },
    "flutter.pub-get-offline": {
      "desc": "사본 의존성 — 기존 pub 캐시에서만 채운다(네트워크 없음). 실측 2~3초",
      "bin": "/opt/homebrew/bin/flutter",
      "argv": [
        "pub",
        "get",
        "--offline"
      ],
      "cwd": "{dir}",
      "params": {
        "dir": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)+gostop/sandbox/[A-Za-z0-9][A-Za-z0-9._-]{0,80}/(?:work|clean)$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 30,
      "maxSeconds": 45
    },
    "flutter.test-defines": {
      "desc": "사본에서 사람이 쓴 기존 시험을 씨앗(dart-define 3자리, 안 쓰는 자리는 LG_NOOP=1)으로 돌린다 — 재현(설계 §5.2③). 실측 최대 49초(벤치 실주행 1판, 부하 중, 10-03) → 최대 시간 1.5배 74초, 시간 제한 68초",
      "bin": "/opt/homebrew/bin/flutter",
      "argv": [
        "test",
        "--no-pub",
        "--timeout",
        "none",
        "{test}",
        "--dart-define",
        "{d1}",
        "--dart-define",
        "{d2}",
        "--dart-define",
        "{d3}"
      ],
      "cwd": "{dir}",
      "params": {
        "dir": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)+gostop/sandbox/[A-Za-z0-9][A-Za-z0-9._-]{0,80}/(?:work|clean)$",
        "test": "^test/(?:[A-Za-z0-9_]+/)*[A-Za-z0-9_]+_test\\.dart$",
        "d1": "^(?:REPLAY_GAMES|REPLAY_SEED_BASE|SOAK_GAMES|SOAK_SEED_BASE|SOAK_DIFFICULTY|COACH_SOAK_GAMES|COACH_SOAK_SEED_BASE|LG_NOOP)=[A-Za-z0-9_]{1,16}$",
        "d2": "^(?:REPLAY_GAMES|REPLAY_SEED_BASE|SOAK_GAMES|SOAK_SEED_BASE|SOAK_DIFFICULTY|COACH_SOAK_GAMES|COACH_SOAK_SEED_BASE|LG_NOOP)=[A-Za-z0-9_]{1,16}$",
        "d3": "^(?:REPLAY_GAMES|REPLAY_SEED_BASE|SOAK_GAMES|SOAK_SEED_BASE|SOAK_DIFFICULTY|COACH_SOAK_GAMES|COACH_SOAK_SEED_BASE|LG_NOOP)=[A-Za-z0-9_]{1,16}$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 68,
      "maxSeconds": 74
    },
    "flutter.test-file": {
      "desc": "사본에서 사람이 쓴 기존 시험 파일 하나를 그대로 돌린다 — 회귀 주입·CI 실패 재현. 실측 최대 37.8초(독립 검토 재측정, 부하 중) → 최대 시간 1.5배 57초, 시간 제한 52초. 긴 CI 시험은 넘을 수 있다(1b 에서 시험별로)",
      "bin": "/opt/homebrew/bin/flutter",
      "argv": [
        "test",
        "--no-pub",
        "--timeout",
        "none",
        "{test}"
      ],
      "cwd": "{dir}",
      "params": {
        "dir": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)+gostop/sandbox/[A-Za-z0-9][A-Za-z0-9._-]{0,80}/(?:work|clean)$",
        "test": "^test/(?:[A-Za-z0-9_]+/)*[A-Za-z0-9_]+_test\\.dart$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 52,
      "maxSeconds": 57
    },
    "gh.run-list": {
      "desc": "CI 신호(읽기 전용) — 고스톱 저장소 최근 실행 50건 JSON. 저장소는 작업 폴더의 git 원격으로 정한다. 실측 2.1초",
      "bin": "/opt/homebrew/bin/gh",
      "argv": [
        "run",
        "list",
        "--json",
        "conclusion,headSha,name,url,databaseId,createdAt,workflowName,status,event",
        "--limit",
        "50"
      ],
      "cwd": "{repo}",
      "params": {
        "repo": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)*gostop_app$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 30,
      "maxSeconds": 45
    },
    "gh.run-log-failed": {
      "desc": "CI 신호(읽기 전용) — 실패한 실행의 실패 단계 로그(실측 1.3초·252KB). 그래프가 실패 줄 + 끝부분 48KB 로 자른다",
      "bin": "/opt/homebrew/bin/gh",
      "argv": [
        "run",
        "view",
        "{run_id}",
        "--log-failed"
      ],
      "cwd": "{repo}",
      "params": {
        "repo": "^/(?:(?!\\.{1,2}/)[A-Za-z0-9._-]+/)*gostop_app$",
        "run_id": "^[0-9]{1,15}$"
      },
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 30,
      "maxSeconds": 45
    },
    "gostop.qa-gate": {
      "desc": "실기 QA 관문 — 에뮬레이터 빈가·디스크 16GiB·부하(우리 에뮬레이터 몫 제외) 10·01:30~04:30",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "gate"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 60,
      "maxSeconds": 90
    },
    "gostop.qa-build": {
      "desc": "QA 드라이버를 얹은 디버그 APK(커밋·드라이버 지문별 캐시). git archive 로 /tmp 에 풀어 빌드 후 지운다",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "build",
        "--rev",
        "{rev}"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 3600,
      "params": {
        "rev": "^[A-Za-z0-9._/-]{1,60}$"
      },
      "maxSeconds": 5400
    },
    "gostop.qa-emu-up": {
      "desc": "gostop_ads 를 창 없이 띄우고 비행기 모드(외부 송출 0). 남의 에뮬레이터가 있으면 거부",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "emu-up"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 600,
      "maxSeconds": 900
    },
    "gostop.qa-emu-down": {
      "desc": "우리가 띄운 에뮬레이터만 끈다(표식 pid)",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "emu-down"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 120,
      "maxSeconds": 180
    },
    "gostop.qa-install": {
      "desc": "APK 설치",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "install",
        "--apk",
        "{apk}"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 600,
      "params": {
        "apk": "^/[A-Za-z0-9._/-]+\\.apk$"
      },
      "maxSeconds": 900
    },
    "gostop.qa-play": {
      "desc": "판 두기 + 녹화(screenrecord 170초 조각) + logcat + 사건 수거. 판당 상한 600초",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "play",
        "--run",
        "{run}",
        "--seed",
        "{seed}",
        "--games",
        "{games}",
        "--diffs",
        "{diffs}",
        "--rev",
        "{rev}",
        "--max-game-sec",
        "600"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 3600,
      "params": {
        "run": "^[A-Za-z0-9._-]{1,80}$",
        "seed": "^[0-9]{1,9}$",
        "games": "^[0-9]{1,2}$",
        "diffs": "^[0-2](,[0-2]){0,5}$",
        "rev": "^[0-9a-f]{7,40}$"
      },
      "maxSeconds": 5400
    },
    "gostop.qa-analyze": {
      "desc": "결정적 검사(모든 프레임·사건·logcat) + LLM 눈 검사용 3×3 묶음",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "analyze",
        "--run",
        "{run}",
        "--day",
        "{day}"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 1800,
      "params": {
        "run": "^[A-Za-z0-9._-]{1,80}$",
        "day": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "maxSeconds": 2700
    },
    "gostop.qa-eye-prompt": {
      "desc": "여러 판 묶음 LLM 프롬프트(그림은 /tmp 묶음 폴더로 복사)",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "eye-batch-prompt",
        "--batch",
        "{batch}",
        "--runs",
        "{runs}",
        "--stage",
        "{stage}",
        "--day",
        "{day}"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 300,
      "params": {
        "batch": "^[A-Za-z0-9._-]{1,80}$",
        "runs": "^[A-Za-z0-9._-]{1,80}(,[A-Za-z0-9._-]{1,80}){0,40}$",
        "stage": "^(first|confirm)$",
        "day": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "maxSeconds": 450
    },
    "gostop.qa-eye-record": {
      "desc": "그래프가 남긴 LLM 답을 판별로 나눠 적는다",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "eye-batch-record",
        "--batch",
        "{batch}",
        "--stage",
        "{stage}",
        "--day",
        "{day}"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 60,
      "params": {
        "batch": "^[A-Za-z0-9._-]{1,80}$",
        "stage": "^(first|confirm)$",
        "day": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "maxSeconds": 90
    },
    "gostop.qa-clip": {
      "desc": "확정 발견마다 ±5초 클립·3×3 프레임·재현 순서",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "clip",
        "--run",
        "{run}",
        "--day",
        "{day}"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 900,
      "params": {
        "run": "^[A-Za-z0-9._-]{1,80}$",
        "day": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "maxSeconds": 1350
    },
    "gostop.qa-signal": {
      "desc": "확정 발견 → 그날 signals.json(1a 접수 형식) + 지시함 줄 후보(쓰기는 그래프 effect)",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "signal",
        "--run",
        "{run}",
        "--day",
        "{day}"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 60,
      "params": {
        "run": "^[A-Za-z0-9._-]{1,80}$",
        "day": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "maxSeconds": 90
    },
    "gostop.qa-cleanup": {
      "desc": "원본 녹화(/tmp/gostop-qa-raw/<run>) 지우기",
      "bin": "/opt/homebrew/bin/python3",
      "argv": [
        "~/.openclaw/workspace/scripts/gostop-qa/gqa.py",
        "cleanup",
        "--run",
        "{run}"
      ],
      "modes": [
        "shadow",
        "live"
      ],
      "timeoutSec": 120,
      "params": {
        "run": "^[A-Za-z0-9._-]{1,80}$"
      },
      "maxSeconds": 180
    }
  }
}

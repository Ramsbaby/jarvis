infra/scripts/_boram_*.py
infra/scripts/board-auto-deploy.sh
infra/scripts/relay-to-owner.sh
infra/scripts/opensync.py
infra/scripts/setup_infra.py
infra/scripts/setup_rag.py

# Runtime
.jarvis.pid
jarvis.log
infra/office/node_modules
infra/office/dist

# Chrome Extension (오너 개인 프로토타입 — 사이트 목록/파서에 PII 결합)
# README.md 만 공개 유지, 나머지는 private 관리
infra/chrome-extension/*
!infra/chrome-extension/README.md

# Claude Code worktrees
.claude/worktrees/

# Archive directories (PII 정리 과정에서 이관된 구파일 — 절대 tracked 금지)
_archive-*/

# interview-fast-path: user-profile 어휘 다수 하드코딩.
# repo PUBLIC이므로 commit 금지 (Iron Law 4). ~/jarvis/.local-backup/ 매시간 자동 백업.
infra/discord/lib/interview-fast-path.js
# interview-verifier-server: SYSTEM_PROMPT few-shot에 user-profile STAR 수치 example 포함.
infra/scripts/interview-verifier-server.mjs
# interview-ralph-runner: 질문 풀에 STAR/회사명/PII 식별자 포함.
infra/scripts/interview-ralph-runner.mjs
# career-coding-mode: 로컬 전용 코딩 연습 도구 — public repo 제외.
infra/discord/lib/career-coding-mode.js
infra/scripts/career-coding-mode.sh
.local-backup/
infra/scripts/*.LOCKED.*

